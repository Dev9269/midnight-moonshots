pragma language_version 0.23;

import CompactStandardLibrary;

/*
 * PrivatePay - private payroll & splits on Midnight.
 *
 * A payroll is kept as a single public counter. The amounts that flow into it
 * are private circuit parameters: each party reveals (via `disclose`) only the
 * value they contribute or claim, never the full picture.
 *
 *   createPayroll(total)  -> the private total is disclosed onto the ledger
 *   fund(amount)          -> payer adds a private amount (only the running total changes)
 *   claim(share)          -> beneficiary withdraws their share (asserted <= balance)
 *
 * The ledger's Counter type is used so that increments/decrements do not depend
 * on reading the current value - the contract only commits to the delta.
 */
export ledger total: Counter;

export circuit createPayroll(totalAmount: Uint<64>): [] {
  total += disclose(totalAmount);
}

export circuit fund(amount: Uint<64>): [] {
  total += disclose(amount);
}

export circuit claim(share: Uint<64>): [] {
  assert(share <= total, "Cannot claim more than the payroll balance");
  total -= disclose(share);
}